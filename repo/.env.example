# Driver Routing local development example
# Copy to .env.local for local use. Do not commit real secrets.

APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_PORT=5173

# Future FastAPI/PostgreSQL implementation
DATABASE_URL=postgresql://driver_routing:driver_routing@postgres:5432/driver_routing
JWT_SECRET=replace-for-local-dev-only
JWT_ISSUER=driver-routing-local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# No-spend defaults for MVP prototype
DISTANCE_PROVIDER=haversine
GEOCODER_PROVIDER=manual
MAPS_API_KEY=
ROUTING_API_KEY=

# Operations
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=15
